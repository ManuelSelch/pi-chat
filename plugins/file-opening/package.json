{
  "name": "@manuelselch/pi-plugin-file-opening",
  "version": "0.1.0",
  "type": "module",
  "description": "Server-local file opening and browser file-link actions",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@manuelselch/pi-sdk": "0.3.0-plugin.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.72.1"
  }
}

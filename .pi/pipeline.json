{
  "version": 1,
  "suites": {
    "build": {
      "command": [
        "node",
        "-e",
        "const { spawnSync } = require('node:child_process'); for (const args of [['ci'], ['run', 'build']]) { const result = spawnSync('npm', args, { stdio: 'inherit' }); if (result.error) { console.error(result.error); process.exit(1); } if (result.status !== 0) process.exit(result.status ?? 1); }"
      ],
      "cwd": ".",
      "timeoutSeconds": 300,
      "staleAfterMinutes": 30,
      "auto": "after-agent"
    },
    "unit": {
      "command": [
        "npm",
        "test"
      ],
      "cwd": ".",
      "timeoutSeconds": 300,
      "staleAfterMinutes": 30,
      "auto": "after-agent"
    },
    "e2e": {
      "command": [
        "npm",
        "run",
        "test:e2e"
      ],
      "cwd": ".",
      "timeoutSeconds": 600,
      "staleAfterMinutes": 60,
      "auto": "manual"
    },
    "production-smoke": {
      "command": [
        "npm",
        "run",
        "test:production-smoke"
      ],
      "cwd": ".",
      "timeoutSeconds": 300,
      "staleAfterMinutes": 60,
      "auto": "manual"
    }
  }
}

{
  "version": 1,
  "suites": {
    "build": {
      "command": [
        "npm",
        "run",
        "build"
      ],
      "cwd": ".",
      "timeoutSeconds": 300,
      "staleAfterMinutes": 30,
      "auto": "after-agent"
    },
    "unit": {
      "command": [
        "npm",
        "test"
      ],
      "cwd": ".",
      "timeoutSeconds": 300,
      "staleAfterMinutes": 30,
      "auto": "after-agent"
    },
    "e2e": {
      "command": [
        "npm",
        "run",
        "test:e2e"
      ],
      "cwd": ".",
      "timeoutSeconds": 600,
      "staleAfterMinutes": 60,
      "auto": "manual"
    },
    "production-smoke": {
      "command": [
        "npm",
        "run",
        "test:production-smoke"
      ],
      "cwd": ".",
      "timeoutSeconds": 300,
      "staleAfterMinutes": 60,
      "auto": "manual"
    }
  },
  "prepare": {
    "command": [
      "npm",
      "ci"
    ],
    "cwd": ".",
    "timeoutSeconds": 300
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "catalogue": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "displayPath": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "exists": {
                "type": "boolean"
              },
              "modified": {
                "type": "number"
              },
              "sessionCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pinned": {
                "type": "boolean"
              },
              "quickChats": {
                "type": "boolean"
              },
              "sessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string"
                    },
                    "nameSource": {
                      "type": "string",
                      "enum": [
                        "manual",
                        "auto",
                        "none"
                      ]
                    },
                    "firstMessage": {
                      "type": "string"
                    },
                    "modified": {
                      "type": "number"
                    },
                    "created": {
                      "type": "number"
                    },
                    "messageCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "archivedAt": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "path",
                    "id",
                    "title",
                    "nameSource",
                    "modified",
                    "created",
                    "messageCount"
                  ]
                }
              },
              "repositoryPath": {
                "type": "string",
                "minLength": 1
              },
              "repositoryName": {
                "type": "string",
                "minLength": 1
              },
              "worktree": {
                "type": "object",
                "properties": {
                  "branch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detached": {
                    "type": "boolean"
                  },
                  "primary": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "detached",
                  "primary"
                ]
              }
            },
            "required": [
              "path",
              "displayPath",
              "name",
              "exists",
              "modified",
              "sessionCount",
              "sessions"
            ]
          }
        }
      },
      "required": [
        "projects"
      ]
    }
  },
  "required": [
    "revision",
    "catalogue"
  ]
}

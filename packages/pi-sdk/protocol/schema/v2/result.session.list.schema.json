{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "title": {
            "type": "string"
          },
          "sessionPath": {
            "type": "string",
            "minLength": 1
          },
          "projectPath": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "blocked",
              "closing"
            ]
          }
        },
        "required": [
          "sessionId",
          "title",
          "projectPath",
          "projectName",
          "status"
        ]
      }
    }
  },
  "required": [
    "revision",
    "sessions"
  ]
}

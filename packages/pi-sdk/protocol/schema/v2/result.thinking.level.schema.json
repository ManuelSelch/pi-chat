{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string"
    },
    "availableModels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thinkingLevel": {
      "type": "string",
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "availableThinkingLevels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    }
  },
  "required": [
    "model",
    "availableModels",
    "thinkingLevel",
    "availableThinkingLevels"
  ]
}

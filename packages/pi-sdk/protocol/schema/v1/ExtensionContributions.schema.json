{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buttons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "enum": [
              "session.header.right",
              "composer.right",
              "composer.below",
              "session.status",
              "settings.section"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string"
          },
          "actionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "slot",
          "label",
          "actionId"
        ]
      }
    },
    "badges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "enum": [
              "session.header.right",
              "composer.right",
              "composer.below",
              "session.status",
              "settings.section"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "default": "neutral",
            "type": "string",
            "enum": [
              "neutral",
              "green",
              "yellow",
              "red"
            ]
          }
        },
        "required": [
          "id",
          "slot",
          "label"
        ]
      }
    },
    "state": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  }
}

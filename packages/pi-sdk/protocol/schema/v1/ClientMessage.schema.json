{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?![\\\\/]{2})(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "openFile"
        }
      },
      "required": [
        "sessionId",
        "requestId",
        "path",
        "version",
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "completeCommandArguments"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "commandName": {
          "type": "string",
          "minLength": 1
        },
        "argumentPrefix": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "requestId",
        "commandName",
        "argumentPrefix"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "prompt"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-pi-normalization": "trim"
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "abort"
        }
      },
      "required": [
        "version",
        "sessionId",
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "uiPromptResponse"
        },
        "promptId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "cancelled": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "cancelled"
              ]
            },
            {
              "type": "object",
              "properties": {
                "cancelled": {
                  "type": "boolean",
                  "const": false
                },
                "value": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                }
              },
              "required": [
                "cancelled",
                "value"
              ]
            }
          ]
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "promptId",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "openProject"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "type",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "openSession"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "type",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "newSession"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "version",
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "basePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "showHidden": {
          "type": "boolean"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "browseDirectories"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "path",
        "version",
        "type",
        "requestId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "setSessionArchived"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "archived": {
          "type": "boolean"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "version",
        "type",
        "path",
        "archived",
        "requestId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "pinProject"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pinned": {
          "type": "boolean"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "version",
        "type",
        "path",
        "pinned",
        "requestId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "removeProject"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "version",
        "type",
        "path",
        "requestId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "closeTab"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "type",
        "sessionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "focusTab"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "type",
        "sessionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "runFeature"
        },
        "featureId": {
          "type": "string",
          "const": "thinking.level"
        },
        "input": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "required": [
            "level"
          ]
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "featureId",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "runFeature"
        },
        "featureId": {
          "type": "string",
          "const": "model.select"
        },
        "input": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "model"
          ]
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "featureId",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "runFeature"
        },
        "featureId": {
          "type": "string",
          "const": "session.compact"
        },
        "input": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "featureId",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "runFeature"
        },
        "featureId": {
          "type": "string",
          "const": "app.restart"
        },
        "input": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "featureId",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "runExtensionAction"
        },
        "actionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "sessionId",
        "type",
        "actionId"
      ]
    }
  ]
}

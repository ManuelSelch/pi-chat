{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "accepted"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "state",
        "operationId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "completed"
        }
      },
      "required": [
        "state"
      ]
    }
  ]
}
